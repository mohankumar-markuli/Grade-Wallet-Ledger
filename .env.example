NODE_ENV=development
PORT=3000
POSTGRES_USER=wallet_user
POSTGRES_PASSWORD=local_only_change_before_deployment
POSTGRES_DB=wallet_db
POSTGRES_PORT=5433
DATABASE_URL=postgres://wallet_user:local_only_change_before_deployment@localhost:5433/wallet_db
MIGRATION_EXPECTED_DATABASE=
SEED_EXPECTED_DATABASE=wallet_seed_db
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
RECONCILIATION_ADMIN_TOKEN=replace_with_a_random_admin_token_of_at_least_32_characters
RECONCILIATION_EXPECTED_DATABASE=wallet_db
ENABLE_RECONCILIATION_SCHEDULER=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=mock
